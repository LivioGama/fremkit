node_modules/
dist/
# Runtime state: the dashboard, its backups, the caches, installed widgets and themes,
# secrets in file mode. Everything in data/ but the example config is the user's own.
data/*
!data/fremkit.example.json
.DS_Store
.vitest/
native/.build/
native/dist/
.worktrees/
# Working notes of the coding agents: local only
docs/superpowers/
.superpowers/

# Anything that would be a secret or a key if it existed. None of these belong in the tree, and a
# stray one is easier to ignore here than to remove from history later.
.env
.env.*
*.log
*.p12
*.pem
*.cer
*.keychain
*.keychain-db

# Editor and tool state
.claude/
.idea/
.vscode/

# The iPad app: build output, signing values, Xcode user state
ios/**/.build/
ios/Local.xcconfig
ios/**/xcuserdata/
ios/build/

# Playwright: what a run leaves behind (e2e/)
test-results/
playwright-report/
