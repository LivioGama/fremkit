{
  "sourceLanguage" : "en",
  "strings" : {
    "Allow the camera in Settings" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser l’appareil photo dans Réglages"
          }
        }
      }
    },
    "Cancel" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuler"
          }
        }
      }
    },
    "Can’t reach the Mac" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Mac n’est pas joignable"
          }
        }
      }
    },
    "Check that it is on, on the same network, and that “Allow an iPad on the local network” is turned on." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez qu’il est allumé, sur le même réseau, et que « Autoriser un iPad sur le réseau local » est activé."
          }
        }
      }
    },
    "Check that the Mac shows the same words." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez que le Mac affiche les mêmes mots."
          }
        }
      }
    },
    "Choose your Mac" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez votre Mac"
          }
        }
      }
    },
    "Code" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code"
          }
        }
      }
    },
    "Connecting to %@…" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connexion à %@…"
          }
        }
      }
    },
    "Connecting…" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connexion…"
          }
        }
      }
    },
    "Enter the code" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisir le code"
          }
        }
      }
    },
    "It was removed on the Mac. Pair it again to show the dashboard." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il a été retiré sur le Mac. Appairez-le à nouveau pour afficher le tableau de bord."
          }
        }
      }
    },
    "Looking for its address…" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherche de son adresse…"
          }
        }
      }
    },
    "No Mac found yet. In Fremkit on the Mac, turn on “Allow an iPad on the local network” (Screen tab)." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun Mac trouvé pour l’instant. Dans Fremkit sur le Mac, activez « Autoriser un iPad sur le réseau local » (onglet Écran)."
          }
        }
      }
    },
    "Open Settings" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrir Réglages"
          }
        }
      }
