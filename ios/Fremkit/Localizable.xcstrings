    "Scan the code" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanner le code"
          }
        }
      }
    },
    "Show your Mac’s Fremkit dashboard on this iPad." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichez sur cet iPad le tableau de bord Fremkit de votre Mac."
          }
        }
      }
    },
    "The Mac did not accept the request. Update Fremkit on the Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Mac n’a pas accepté la demande. Mettez Fremkit à jour sur le Mac."
          }
        }
      }
    },
    "The Mac refused the code." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Mac a refusé le code."
          }
        }
      }
    },
    "The camera is not available." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil photo n’est pas disponible."
          }
        }
      }
    },
    "The pairing could not be saved on this iPad." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appairage n’a pas pu être enregistré sur cet iPad."
          }
        }
      }
    },
    "The saved pairing could not be read. Pairing again replaces it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appairage enregistré n’a pas pu être lu. Appairer à nouveau le remplace."
          }
        }
      }
    },
    "This iPad is no longer allowed" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet iPad n’est plus autorisé"
          }
        }
      }
    },
    "This iPad will show the dashboard of %@ instead." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet iPad affichera à la place le tableau de bord de %@."
          }
        }
      }
    },
    "This is not the Mac that showed the code" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
