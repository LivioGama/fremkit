{
  "name": "fremkit",
  "private": true,
  "version": "0.4.1",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.4.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "bash scripts/dev.sh",
    "demo": "bash scripts/demo.sh",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "start": "pnpm --filter server start",
    "kiosk": "bash scripts/kiosk.sh",
    "open": "bash scripts/open.sh",
    "helper:build": "bash scripts/build-helper.sh",
    "helper:install": "bash scripts/install-helper.sh",
    "helper:test": "bash scripts/test-helper.sh",
    "widget:new": "server/node_modules/.bin/tsx server/src/cli/widget.ts new",
    "widget:check": "server/node_modules/.bin/tsx server/src/cli/widget.ts check"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
