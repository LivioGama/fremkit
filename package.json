{
  "name": "fremkit",
  "private": true,
  "version": "0.4.1",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "server",
    "ui"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "bash scripts/dev.sh",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "vp lint",
    "start": "bun run --filter server start",
    "kiosk": "bash scripts/kiosk.sh",
    "helper:build": "bash scripts/build-helper.sh",
    "helper:install": "bash scripts/install-helper.sh",
    "helper:test": "bash scripts/test-helper.sh"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "devDependencies": {
    "vite-plus": "1.3.0"
  }
}
