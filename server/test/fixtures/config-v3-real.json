{
  "version": 3,
  "display": {
    "cols": 64,
    "rows": 17,
    "cell": 40,
    "autoCycleSeconds": 30,
    "theme": "edge",
    "navHeight": 40,
    "navOpacity": 0.6,
    "tileOpacity": 0.8,
    "adminGesture": "longPress",
    "background": { "image": "fremkit-wallpaper.png", "fit": "cover" },
    "navWidgets": [
      { "instanceId": "battery-1", "widgetId": "battery", "slot": "left", "popup": true, "settings": { "showPercent": true } },
      { "instanceId": "cpu-1", "widgetId": "cpu", "slot": "right", "settings": {} }
    ]
  },
  "connections": [
    { "id": "ics-1", "type": "ics", "name": "Calendar", "fields": { "url": "https://calendar.example.com/feed.ics" } },
    { "id": "bambu-1", "type": "bambu", "name": "Printer", "fields": { "host": "192.0.2.10", "serial": "SERIAL-PLACEHOLDER", "model": "autre" } }
  ],
  "secrets": { "backend": "keychain" },
  "locale": "en",
  "marketplace": { "installed": {} },
  "pages": [
    {
      "id": "home",
      "name": "Home",
      "widgets": [
        {
          "instanceId": "clock-1", "widgetId": "clock", "x": 0, "y": 0, "w": 16, "h": 4,
          "showTitle": false, "appearance": "panel",
          "settings": { "cities": "New York=America/New_York, Tokyo=Asia/Tokyo", "seconds": false }
        },
        {
          "instanceId": "weather-1", "widgetId": "weather", "x": 16, "y": 0, "w": 16, "h": 8,
          "showTitle": true, "appearance": "transparent", "settings": { "city": "Example City" }
        },
        {
          "instanceId": "sysmon-1", "widgetId": "cpu", "x": 0, "y": 4, "w": 16, "h": 8,
          "showTitle": true, "opacity": 0.4, "settings": {}
        },
        {
          "instanceId": "claude-1", "widgetId": "claude-usage", "x": 32, "y": 0, "w": 16, "h": 8,
          "title": "Usage", "showTitle": true, "appearance": "accent", "accentStyle": "outline",
          "accentColor": "#d9b36a", "settings": {}
        }
      ]
    },
    {
      "id": "work",
      "name": "Work",
      "widgets": [
        {
          "instanceId": "calendar-1", "widgetId": "calendar", "x": 0, "y": 0, "w": 32, "h": 12,
          "showTitle": true, "settings": { "connection": "ics-1", "days": 3 }
        },
        {
          "instanceId": "battery-1", "widgetId": "battery", "x": 32, "y": 0, "w": 16, "h": 6,
          "showTitle": true, "accentMode": "fill", "settings": { "showPercent": false }
        }
      ]
    },
    {
      "id": "media",
      "name": "Media",
      "widgets": [
        {
          "instanceId": "clock-1", "widgetId": "clock", "x": 0, "y": 0, "w": 24, "h": 8,
          "showTitle": true, "bgColor": "#123456",
          "settings": { "cities": [{ "label": "London", "timezone": "Europe/London", "hour12": false, "seconds": true }], "seconds": true }
        },
        {
          "instanceId": "spotify-1", "widgetId": "spotify", "x": 24, "y": 0, "w": 24, "h": 8,
          "showTitle": false, "background": { "image": "cover-art.jpg", "fit": "cover", "dim": 0.35 }, "settings": {}
        }
      ]
    }
  ]
}
