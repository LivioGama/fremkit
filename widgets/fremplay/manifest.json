      "options": [
        { "value": "contain", "label": { "fr": "Entière, avec des bandes", "en": "Whole, with bars" } },
        { "value": "cover", "label": { "fr": "Remplir, en rognant", "en": "Fill, cropping" } }
      ] }
  } }
